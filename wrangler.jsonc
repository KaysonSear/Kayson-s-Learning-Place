{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kayson-s-learning-place",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloud",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kayson-learning-place",
      "database_id": "8c42dd12-bd95-4637-aea4-abe2063c85cb",
      "migrations_dir": "migrations"
    }
  ]
}
